@startuml c4_component_fraud_detection

!include <C4/C4_Component>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title C4 Component — ML Service & Decision Dispatcher Internals

Container_Boundary(gateway, "API Gateway (Kong)") {
    Component(auth, "Auth & Rate Limit", "Middleware")
    Component(validation, "Request Validation", "Schema Check")
    Component(lb, "Load Balancer", "Traffic Distribution")
}

Container_Boundary(rulesEngine, "Rules Engine") {
    Component(ruleEval, "Rule Evaluator", "30 Rules Engine")
    Component(ruleFeatures, "Feature Lookup", "from Cache")
    Component(rulesRegistry, "Rules Registry", "Postgres Table")
    Component(ruleCache, "Feature Cache", "Redis TTL=60s")
}

Container_Boundary(mlService, "ML Service") {
    Component(featureTransform, "Feature Transformer", "Data Prep")
    Component(inference, "Model Inference", "LightGBM v1.0")
    Component(predCache, "Prediction Cache", "In-memory LRU")
    Component(coldStart, "Cold-Start Handler", "Day 1-30 rules only")
    Component(modelStore, "Model Store", "v1.0 Blue / v2.0 Green")
}

Container_Boundary(dispatcher, "Decision Dispatcher") {
    Component(normalizer, "Score Normalizer", "Combine Rules + ML")
    Component(classifier, "Risk Classifier", "Green/Yellow/Red/Urgent")
    Component(router, "Decision Router", "Route to queue/allow/block")
    Component(formatter, "Output Formatter", "JSON Contract")
    Component(fallback, "Fallback Manager", "Error Handling")
}

Container_Boundary(dataLayer, "Data Layer") {
    Component(opsDb, "Operations DB", "Postgres")
    Component(history, "Customer History", "Postgres")
    Component(risk, "Counterparty Risk", "Postgres")
    Component(decisionLog, "Decision Log", "Postgres")
}

Container_Boundary(quality, "Quality & Monitoring") {
    Component(contract, "Contract Validator", "Schema Check")
    Component(latency, "Latency Monitor", "p50/p95/p99")
    Component(precisionRecall, "Precision/Recall", "Moving 1000")
    Component(drift, "Feature Drift", "KS Test")
}

Rel(auth, validation, "Pass Auth")
Rel(validation, lb, "Route")

Rel(lb, ruleEval, "Operation")
Rel(ruleEval, ruleFeatures, "Get Features")
Rel(ruleFeatures, ruleCache, "Lookup")
Rel(ruleCache, rulesRegistry, "Miss")
Rel(ruleEval, classifier, "Rules Score")

Rel(lb, coldStart, "Check Age")
Rel(coldStart, inference, "If Age>=30")
Rel(featureTransform, ruleFeatures, "Transform")
Rel(inference, modelStore, "Load Model")
Rel(inference, predCache, "Cache")
Rel(inference, classifier, "ML Score")

Rel(classifier, normalizer, "Risk Score")
Rel(normalizer, router, "Classify")
Rel(router, contract, "Validate")
Rel(contract, formatter, "Format JSON")
Rel(formatter, fallback, "Fallback Info")

Rel(formatter, decisionLog, "Store")
Rel(formatter, opsDb, "Store Op")

Rel(precisionRecall, latency, "Alert if Precision<60%")
Rel(latency, contract, "Alert if Latency>200ms")
Rel(drift, precisionRecall, "Alert if KS>0.15")

Rel(inference, fallback, "Timeout", "Error")
Rel(featureTransform, fallback, "Error")
Rel(ruleEval, fallback, "Error")
Rel(fallback, router, "Rules-Only")

note right of inference
LightGBM 4.3.0
Latency: <5ms
Features: 50+
Batch: 1 (sync)
GPU: No (CPU)
end note

note right of classifier
Risk:
• Green: <0.3
• Yellow: 0.3-0.7
• Red: ≥0.7
• Urgent: >500K
end note

note right of fallback
Fallback:
1. Rules-only
2. Cache hit
3. Conservative
4. Manual review
All: <5ms
end note

note right of formatter
JSON:
{decision, score, confidence,
reason, shap_top_3, fallback,
trace_id}
end note

@enduml
