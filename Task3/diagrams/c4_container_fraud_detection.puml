@startuml c4_container_fraud_detection

!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title C4 Container — Fraud Detection Service (#1)

Person(user, "Banking Officer", "Проверяет операции")

System_Ext(bankFrontend, "Banking Frontend", "Operation API", "Входящие операции (480K/месяц)")

System_Boundary(fraudDetection, "Fraud Detection System") {
    Container(gateway, "API Gateway", "Kong", "Auth, Rate Limit, Routing")

    Container(rulesEngine, "Rules Engine", "Deterministic", "30 Rules, <2ms, Coverage 30%")

    Container(mlService, "ML Service", "LightGBM", "Inference <5ms, v1.0 Blue / v2.0 Green")

    Container(dispatcher, "Decision Dispatcher", "Business Logic", "Classify: Green/Yellow/Red/Urgent")

    Container(expertQueue, "Expert Queue", "Message Queue", "Yellow cases to Experts")

    Container(cache, "Cache Layer", "Redis", "Features (TTL=60s), Predictions (LRU)")

    Container(opsDb, "Operations DB", "PostgreSQL", "480K ops/month, Decisions, History")

    Container(auditLog, "Audit Log", "PostgreSQL", "Context, SHAP, Compliance")
}

System_Ext(ofac, "OFAC Check", "Black List API")
System_Ext(riskDb, "Counterparty Risk", "Risk Database")
System_Ext(monitoring, "Monitoring", "Prometheus + Grafana")

Person(experts, "AML Experts", "10 people")

Rel(user, bankFrontend, "Operation Request")
Rel(bankFrontend, gateway, "HTTPS/REST")

Rel(gateway, rulesEngine, "Classify")
Rel(rulesEngine, cache, "Fetch Features")
Rel(cache, opsDb, "Cache Miss")

Rel(gateway, mlService, "Score (parallel)")
Rel(mlService, cache, "Get Features")

Rel(gateway, ofac, "Check Black List")
Rel(gateway, riskDb, "Get Risk Score")

Rel(rulesEngine, dispatcher, "Rules Score")
Rel(mlService, dispatcher, "ML Score")

Rel(dispatcher, opsDb, "Store Decision")
Rel(dispatcher, auditLog, "Log Context + SHAP")

Rel(dispatcher, expertQueue, "Queue Yellow")
Rel(expertQueue, experts, "Assign for Review")

Rel(experts, auditLog, "Store Review")

Rel(monitoring, rulesEngine, "Monitor")
Rel(monitoring, mlService, "Monitor")
Rel(monitoring, dispatcher, "Monitor")

Rel(gateway, bankFrontend, "Return Decision")

note right of dispatcher
Decision Classes:
• Green: <0.3 → AUTO (70%)
• Yellow: 0.3-0.7 → REVIEW (20%)
• Red: ≥0.7 → BLOCK (8%)
• Urgent: >500K → ESCALATE (2%)

Output JSON:
{decision, score, confidence, shap_top_3, fallback, trace_id}
end note

note right of cache
Fallback:
1. ML timeout → RULES ONLY
2. Rules error → conservative
3. All down → MANUAL REVIEW
SLA: <100ms all paths
end note

note bottom of monitoring
Tiers:
• T1: Latency (real-time)
• T2: Precision/Recall (hourly)
• T3: Feature drift (daily)
• T4: Business (weekly)
end note

@enduml
