@startuml c4_container_delinquency

!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

title C4 Container — Delinquency Prediction Service (#4)

System_Ext(bankInternal, "Loan Management System", "Legacy", "Loan Status & Details")

System_Boundary(delinquencySystem, "Delinquency Prediction") {
    Container(gateway4, "API Gateway", "Gateway", "Request Routing")

    Container(model4, "Delinquency Model", "XGBoost", "Predict 30/90-day delinquency")

    Container(scoring4, "Risk Scoring Engine", "Business Logic", "Risk Level Classification")

    Container(strategy4, "Collection Strategy Dispatcher", "Decision Engine", "Route to strategy")

    Container(loanDb, "Loan DB", "PostgreSQL", "Loan Info, Balance")

    Container(paymentDw, "Payment History", "Data Warehouse", "Historical Payments 24mo")

    Container(audit4, "Audit Trail", "PostgreSQL", "Predictions & Decisions")
}

System_Ext(notify4, "Early Warning Notifications", "SMS/Email", "Send reminders")

System_Ext(crm4, "Collection Workflow", "CRM System", "Assign collectors")

System_Ext(monitor4, "Monitoring", "Prometheus", "Track predictions")

Rel(bankInternal, gateway4, "Loan Status Query")

Rel(gateway4, model4, "Get Prediction")

Rel(model4, paymentDw, "Fetch Payment History")

Rel(paymentDw, scoring4, "Historical Data")

Rel(scoring4, strategy4, "Risk Score")

Rel(strategy4, notify4, "Send Early Notice")

Rel(strategy4, crm4, "Assign to Collector")

Rel(strategy4, loanDb, "Store Prediction")

Rel(strategy4, audit4, "Log Decision")

Rel(strategy4, gateway4, "Return Score")

Rel(monitor4, model4, "Monitor")
Rel(monitor4, scoring4, "Monitor")

note right of model4
XGBoost Model:
• 30-day delinquency prob
• 90-day delinquency prob
• Latency: <500ms (async OK)
• Retrain: quarterly
• Features: payment history, balance
end note

note right of scoring4
Risk Levels:
• Green: <10% → Monitor
• Yellow: 10-30% → SMS
• Red: >30% → Call Collector
end note

note right of strategy4
Actions:
• Green: Monitor only
• Yellow: SMS + offer
• Red: Escalate to collector
end note

@enduml
